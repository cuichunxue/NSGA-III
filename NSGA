    data[f"pred_{name}"] = pareto_Y[:, i]

# 逸脱量
for i, name in enumerate(target_names):
    target = TARGETS.get(name, 0.0)
    data[f"dev_{name}"] = np.abs(pareto_Y[:, i] - target)

# 目的関数値
for i, name in enumerate(obj_calculator.get_objective_names()):
